{
    "$schema": "http://json.schemastore.org/template",
    "author": "ChustaSoft - xaberue",
    "name": "ChustaSoft.Templates.WebApi",
    "description": "ChustaSoft .NET9 Minimal API template containing pre-built configurations such as Versioning and Open API",
    "defaultName": "ChustaSoft.WebApi",
    "classifications": [
        "Web",
        "ASP.NET"
    ],
    "identity": "ChustaSoft.Templates.WebApi",
    "shortName": "cs-webapi",
    "sourceName": "ChustaSoft.Templates.WebApi",
    "repository": {
        "url": "https://github.com/ChustaSoft/solution-templates/tree/main/dotnet/ChustaSoft.Templates.WebApi",
        "type": "GitHub"
    },
    "projectURL": "https://github.com/ChustaSoft/solution-templates",
    "releaseNotes": "https://github.com/ChustaSoft/solution-templates/blob/main/dotnet/ChustaSoft.Templates.WebApi/release_notes.md",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "symbols": {
        "apiDoc": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "swagger",
                    "value": "swagger",
                    "description": "Use Swagger as Open API documentation UI."
                },
                {
                    "choice": "scalar",
                    "value": "scalar",
                    "description": "Use Scalar as Open API documentation UI."
                }
            ],
            "defaultValue": "swagger",
            "description": "Select the Open API documentation UI to use in the project."
        }
    },
    "sources": [
        {
            "include": [
                "**/*"
            ],
            "modifiers": [
                {
                    "condition": "(apiDoc != \"swagger\")",
                    "exclude": [
                        "./ChustaSoft.Templates.WebApi/Configuration/SwaggerConfigurationHelper.cs"
                    ]
                }
            ]
        }
    ]
}